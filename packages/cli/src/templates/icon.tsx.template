import { View } from '@tarojs/components';
import { normalizeColor } from '../color';
import { resolveIconSize } from '../size';
import type { IconProps } from '../types';

const quote = '"';

export const #componentName# = (props: IconProps) => {
  const { size = #size#, color, style = {}, className = '' } = props;
  const isStr = typeof color === 'string';
  const colors = normalizeColor(color);
  const svgSize = resolveIconSize(size);

  return (
    <View
      style={{
        backgroundImage: `url(#svg#)`,
        backgroundSize: '100% 100%',
        width: svgSize,
        height: svgSize,
        ...style,
      }}
      className={className}
    />
  );
};
