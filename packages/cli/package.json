{
  "name": "@wesvg/cli",
  "version": "0.4.0",
  "private": false,
  "license": "MIT",
  "bin": {
    "wesvg": "./bin/run"
  },
  "files": [
    "/bin",
    "/dist",
    "/oclif.manifest.json"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "vp pack && cp -R ./src/templates ./dist/templates",
    "dev": "vp pack --watch",
    "prepack": "npm run build && oclif manifest",
    "postpack": "rimraf oclif.manifest.json"
  },
  "dependencies": {
    "@oclif/core": "^2.11.8",
    "@oclif/plugin-help": "^5.2.16",
    "axios": "^1.4.0",
    "fs-extra": "^11.1.1",
    "lodash": "^4.17.21",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/xml2js": "^0.4.11",
    "oclif": "^3.11.3"
  },
  "oclif": {
    "bin": "wesvg",
    "commands": "./dist/commands",
    "dirname": "wesvg",
    "plugins": [
      "@oclif/plugin-help"
    ]
  }
}
