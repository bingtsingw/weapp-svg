{
  "name": "weapp-svg",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "vp check && pnpm run typecheck",
    "check:fix": "vp check --fix && pnpm run typecheck",
    "check-publish": "pnpm run check && pnpm run test",
    "clean": "del **/dist **/.build **/.swc **/.turbo **/node_modules !node_modules",
    "commit": "czg",
    "dev": "turbo run dev",
    "prepare": "vp hooks enable",
    "test": "pnpm run build && vp test",
    "typecheck": "pnpm --filter @wesvg/cli exec tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@xstools-dev/cli-toolkit": "^0.2.0",
    "@xstools-dev/config-ts": "^0.1.0",
    "typescript": "5.8.3",
    "vite-plus": "^0.3.0"
  },
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "overrides": {
      "@wesvg/cli": "workspace:*"
    }
  }
}
